# Secrets — never committed, matches the CLAUDE.md rule (never read/commit .env)
**/.env

# Compiled output — regenerate from flow-core/src, flow-runtime/src (exact
# output path not yet decided; ignore .class files wherever they land)
*.class

# Logs — journal output, not a deliverable
**/logs/

# Portable JDK, if fetched here rather than reused from ../motivewave/tools
/tools/

# Nightly review reports (analysis/daily_report.py) -- generated trading data, not source
/reports/

# Real exported market data + backtest run output — not source, resolves
# the "not yet decided" open item in D-79 (docs/dynamic/decisions.md)
analysis/data/

# ReplayHarness's own output, written fresh every run alongside whatever
# fixture it replayed (ReplayHarness.replay()'s sessionDir/replay/) — not
# a deliverable, same reasoning as build output.
flow-core/fixtures/*/replay/

# D-88: live retained per-construct data (rolling 7 trading days). Recordings
# worth keeping are copied into flow-core/fixtures/ and committed from there.
/data/
/data_take1/

# Python bytecode from analysis/
__pycache__/
