# Example of the secrets the system may need. Copy the names into .env (only the user edits .env -- CLAUDE.md).
# Telegram alert bot (planned, 2026-09-28): create it with @BotFather, then message it once and read your chat id.
TELEGRAM_BOT_TOKEN=<bot token from @BotFather>
TELEGRAM_CHAT_ID=<numeric chat id the alerts are sent to>
